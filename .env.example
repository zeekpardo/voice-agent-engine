# --- xAI (server-side only; never exposed to callers) ---
XAI_API_KEY="xai-..."
XAI_BASE_URL="https://api.x.ai/v1"

# --- Anthropic (optional; server-side only) ---
# When set, TEXT conversations (turn-runner) whose agent has no explicit
# models.respond override are generated by Claude instead of the xAI default —
# text reads warmer on Claude. Leave UNSET to keep the xAI text path (the
# gateway boots and runs normally without it). Also powers /v1/translate.
# The VOICE respond path is untouched (LiveKit Inference has no Anthropic).
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_TEXT_MODEL="claude-sonnet-5"

# --- OpenAI (optional; server-side only) ---
# When set, TEXT conversations (turn-runner) whose node/agent has no explicit
# judge model override are objective-judged by OpenAI (gpt-5-mini) instead of
# the xAI default. Leave UNSET to keep the xAI text judge path (the gateway
# boots and runs normally without it). The WORKER's VOICE judge already
# reaches OpenAI via LiveKit Inference — this only wires the gateway TEXT judge.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_JUDGE_MODEL="gpt-5-mini"

# --- server ---
PORT="8787"

# --- storage (Postgres; keys, usage, agents, calls, webhooks) ---
DATABASE_URL="postgres://localhost:5432/voice_gateway"
# Legacy SQLite file — only read by scripts/migrate-sqlite-to-pg.ts
DB_PATH="./data/gateway.db"

# --- admin API (key issuance + usage over HTTP; disabled if unset) ---
ADMIN_TOKEN=""

# --- voice agent engine ---
# LiveKit Cloud project (required for /v1/sessions and agent dispatch)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# The agent name the deployed worker registers under (worker/livekit.toml)
LIVEKIT_AGENT_NAME="voice-agent"
# Shared secret for agent-worker → gateway /internal routes (disabled if unset)
INTERNAL_KEY=""
# Model proxy defaults
CHAT_DEFAULT_MODEL="grok-4-fast"
TTS_DEFAULT_VOICE="ara"

# --- transcription defaults ---
DEFAULT_LANGUAGE="en"
STT_FORMAT="true"            # xAI STT "format" field: true = formatted/natural text
MAX_UPLOAD_BYTES="157286400" # 150 MB cap for audio uploads (~90 min)

# --- media (video files + URLs; needs ffmpeg + yt-dlp) ---
MEDIA_MAX_UPLOAD_BYTES="1073741824"  # 1 GB cap for uploaded video files
MEDIA_MAX_DURATION_SECONDS="5400"    # extract/transcribe up to 1 h 30 min
