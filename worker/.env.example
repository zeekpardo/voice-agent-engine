# LiveKit (auto-provided on LiveKit Cloud deploys; set manually for local dev)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Must match the gateway's LIVEKIT_AGENT_NAME
AGENT_NAME="voice-agent"

# Control plane
GATEWAY_URL="http://localhost:8787"
GATEWAY_INTERNAL_KEY=""
