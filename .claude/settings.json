{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-reminder.sh\"",
            "timeout": 10,
            "statusMessage": "Checking worker vendor sync"
          }
        ]
      }
    ]
  }
}
